# Optional Deribit API credentials.
# Public tick-by-tick feeds (book.*.raw, incremental_ticker.*, trades.*.raw)
# work without authentication; setting read-only credentials enables in-band
# WebSocket authentication and automatic token refresh.
# DERIBIT_CLIENT_ID="your_client_id"
# DERIBIT_CLIENT_SECRET="your_client_secret"

# Optional Deribit endpoint overrides (defaults to production mainnet)
# DERIBIT_WS_URL="wss://www.deribit.com/ws/api/v2"
# DERIBIT_REST_URL="https://www.deribit.com/api/v2"

# Optional S3 / S3-compatible (Cloudflare R2, MinIO) upload configuration
# S3_BUCKET="your-market-data-bucket"
# S3_PREFIX="deribit"
# AWS_REGION="eu-west-2"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# Logging verbosity (e.g. info, debug, deribit_tick_collector=debug)
RUST_LOG="info,deribit_tick_collector=info"
